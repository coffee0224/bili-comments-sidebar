{
  "manifest_version": 3,
  "name": "Bili Comments Sidebar",
  "version": "3.5.4",
  "description": "一个 Edge/Chrome 扩展（Manifest V3），为 Bilibili 视频页面提供左视频、右评论栏的双栏浏览体验。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*"
      ],
      "js": [
        "lib.js",
        "content.js"
      ],
      "css": [
        "sidebar.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://api.bilibili.com/*",
    "https://www.bilibili.com/*"
  ],
  "permissions": [
    "storage"
  ],
  "key": ""
}