{
    "action":  {
                   "default_icon":  {
                                        "16":  "icons/icon16.png",
                                        "48":  "icons/icon48.png"
                                    },
                   "default_title":  "切换评论侧栏"
               },
    "background":  {
                       "service_worker":  "background.js"
                   },
    "content_scripts":  [
                            {
                                "css":  [
                                            "sidebar.css"
                                        ],
                                "js":  [
                                           "content.js"
                                       ],
                                "matches":  [
                                                "https://www.bilibili.com/video/*"
                                            ],
                                "run_at":  "document_idle"
                            }
                        ],
    "description":  "左视频+右栏(简介/评论/相关视频)布局,评论时间可点击跳转",
    "host_permissions":  [
                             "https://api.bilibili.com/*",
                             "https://www.bilibili.com/*"
                         ],
    "icons":  {
                  "128":  "icons/icon128.png",
                  "16":  "icons/icon16.png",
                  "48":  "icons/icon48.png"
              },
    "key":  "",
    "manifest_version":  3,
    "name":  "Bili Comments Sidebar",
    "permissions":  [
                        "storage",
                        "activeTab"
                    ],
    "update_url":  "https://clients2.google.com/service/update2/crx",
    "version":  "1.3.0"
}
