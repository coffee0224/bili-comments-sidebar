{
  "manifest_version": 3,
  "name": "Bili Comments Sidebar",
  "version": "3.5.3",
  "description": "宸﹁棰?鍙虫爮(绠€浠?璇勮/鐩稿叧瑙嗛)甯冨眬,璇勮鏃堕棿鍙偣鍑昏烦杞?,
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*"
      ],
      "js": [
        "lib.js",
        "content.js"
      ],
      "css": [
        "sidebar.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://api.bilibili.com/*",
    "https://www.bilibili.com/*"
  ],
  "permissions": [
    "storage"
  ],
  "key": ""
}
