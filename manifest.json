{
  "manifest_version": 3,
  "name": "Bili Comments Sidebar",
  "version": "3.0.0",
  "description": "左视频+右栏(简介/评论/相关视频)布局,评论时间可点击跳转",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/video/*"],
      "js": ["lib.js", "content.js"],
      "css": ["sidebar.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://api.bilibili.com/*",
    "https://www.bilibili.com/*"
  ],
  "permissions": ["storage"],
  "key": ""
}
